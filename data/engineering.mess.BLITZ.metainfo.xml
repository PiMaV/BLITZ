<component type="desktop-application">
  <id>engineering.mess.BLITZ</id>
  <name>BLITZ</name>
  <summary>Explore large image datasets</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="engineering.mess">
    <name>M.E.S.S. – Mattern Engineering &amp; Software Solutions</name>
  </developer>
  <description>
    <p>
      BLITZ (Bulk Loading and Interactive Time series Zonal analysis) is the
      viewer component of the WETTER Framework. It is a high-performance,
      matrix-based image exploration and analysis tool for massive image
      datasets as well as single-image workflows.
    </p>
    <p>
      Drag and drop an old, dusty image folder and get it back in action:
      browse stacks, inspect zones, and work with timelines without a heavy
      setup.
    </p>
    <p>Features:</p>
    <ul>
      <li>Fast loading of large image sets, video, and NumPy matrix (*.npy) data</li>
      <li>Drag-and-drop workflows with automatic resource management</li>
      <li>Matrix-based processing with Numba-accelerated statistics</li>
      <li>Interactive zones, timelines, and visualization on top of PyQtGraph</li>
      <li>Optional sync with WOLKE over the network</li>
    </ul>
  </description>
  <launchable type="desktop-id">engineering.mess.BLITZ.desktop</launchable>
